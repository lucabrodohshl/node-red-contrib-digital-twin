{
    "name": "node-red-contrib-digital-twin-aligned",
    "version": "0.2.0",
    "description": "Node-RED nodes for modeling semantically aligned Digital Twins (fork of @digitaltwins/node-red-contrib-digital-twin with PT/DT semantic alignment)",
    "directories": {
        "example": "examples"
    },
    "node-red": {
        "nodes": {
            "dt-action": "src/dt-action/dt-action.js",
            "dt-asset": "src/dt-asset/dt-asset.js",
            "dt-event": "src/dt-event/dt-event.js",
            "dt-graph": "src/dt-graph/dt-graph.js",
            "dt-property": "src/dt-property/dt-property.js",
            "dt-relation": "src/dt-relation/dt-relation.js",
            "dt-model": "src/dt-model/dt-model.js",
            "dt-ontology": "src/dt-ontology/dt-ontology.js",
            "dt-pt-view": "src/dt-pt-view/dt-pt-view.js",
            "dt-behavior": "src/dt-behavior/dt-behavior.js",
            "dt-alignment": "src/dt-alignment/dt-alignment.js",
            "dt-align-gate": "src/dt-align-gate/dt-align-gate.js"
        },
        "version": ">=1.3.0"
    },
    "devDependencies": {
        "@tsconfig/node16": "^16.1.3",
        "@types/node": "^20.12.7",
        "@types/node-red": "^1.3.5",
        "typescript": "^5.4.5"
    },
    "scripts": {
        "build": "tsc",
        "test": "node --test test/",
        "bench": "node bench/drone-variants.js",
        "clean": "rimraf src/**/*.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lucabrodohshl/node-red-contrib-digital-twin.git"
    },
    "keywords": [
        "node-red",
        "digital-twin",
        "iot",
        "model",
        "semantic",
        "semantic-alignment",
        "timed-automata",
        "bisimulation",
        "ontology"
    ],
    "author": "Charles Steinmetz",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/lucabrodohshl/node-red-contrib-digital-twin/issues"
    },
    "homepage": "https://github.com/lucabrodohshl/node-red-contrib-digital-twin/tree/semantic-alignment#readme",
    "engines": {
        "node": ">=16"
    },
    "bin": {
        "dt-align": "src/alignment/cli.js"
    }
}
