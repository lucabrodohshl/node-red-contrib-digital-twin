{
    "extends": "@tsconfig/node16/tsconfig.json",
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "nodes"
    ],
    "compilerOptions": {
        "rootDir": "src",
        "target": "es2019",
        "module": "commonjs",
        "sourceMap": true,
        "moduleResolution": "node",
        "skipLibCheck": true
    }
}