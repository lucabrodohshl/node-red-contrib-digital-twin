  {
    "id": "phi",
    "type": "dt-ontology",
    "name": "drone ontology",
    "version": "1",
    "ontology": "; Shared ontology K for the crop-spraying drone (QF_LRA).\n; Sources: operator RTB reserve policy, EASA open-category altitude cap,\n; mission plan (nine-cell field).\n\n; === SORTS ===\nsort Energy        ; battery state of charge, percent\nsort Length        ; metres\nsort Rate          ; litres per minute\nsort Count         ; number of field cells\n\n; === FUNCTIONS ===\nfun soc       : Energy   ; current state of charge\nfun soc_rtb   : Energy   ; return-to-base reserve\nfun alt       : Length   ; altitude above ground\nfun alt_max   : Length   ; regulatory altitude cap\nfun flow      : Rate     ; pesticide pump flow\nfun covered   : Count    ; cells sprayed so far\nfun num_cells : Count    ; cells in the mission plan\n\n; === RELATIONS ===\nrel armed :              ; motors armed by the operator\nrel rtb_active :         ; return-to-base manoeuvre engaged\nrel cell_complete :      ; current cell sprayed at the prescribed rate\n\n; === AXIOMS ===\naxiom reserve   : (= soc_rtb 25)\naxiom soc_lo    : (>= soc 0)\naxiom soc_hi    : (<= soc 100)\naxiom alt_nn    : (>= alt 0)\naxiom alt_cap   : (= alt_max 120)\naxiom alt_lim   : (<= alt alt_max)\naxiom flow_nn   : (>= flow 0)\naxiom no_ground_spray : (=> (> flow 0) (> alt 0))\naxiom cells     : (= num_cells 9)\naxiom cov_lo    : (>= covered 0)\naxiom cov_hi    : (<= covered num_cells)\n"
  },
  {
    "id": "ptview",
    "type": "dt-pt-view",
    "name": "flight controller (PT)",
    "format": "json",
    "model": "{\n  \"name\": \"FlightControllerPT\",\n  \"clocks\": [\"x\"],\n  \"initial\": \"LANDED\",\n  \"locations\": [\n    { \"name\": \"LANDED\",   \"labels\": [\"landed\"] },\n    { \"name\": \"TAKEOFF\",  \"invariant\": \"x <= 8\",  \"labels\": [\"airborne\"] },\n    { \"name\": \"SPRAYING\", \"invariant\": \"x <= 30\", \"labels\": [\"airborne\", \"spraying\"] },\n    { \"name\": \"RTB\",      \"invariant\": \"x <= 20\", \"labels\": [\"airborne\", \"returning\"] }\n  ],\n  \"edges\": [\n    { \"from\": \"LANDED\",   \"to\": \"TAKEOFF\",  \"label\": \"arm?\",          \"reset\": \"x\" },\n    { \"from\": \"TAKEOFF\",  \"to\": \"SPRAYING\", \"label\": \"start_spray!\",  \"guard\": \"x >= 3\",  \"reset\": \"x\" },\n    { \"from\": \"SPRAYING\", \"to\": \"SPRAYING\", \"label\": \"cell_done!\",    \"guard\": \"x >= 10\", \"reset\": \"x\" },\n    { \"from\": \"SPRAYING\", \"to\": \"SPRAYING\", \"label\": \"nozzle_check\" },\n    { \"from\": \"SPRAYING\", \"to\": \"RTB\",      \"label\": \"bat_low!\",      \"reset\": \"x\" },\n    { \"from\": \"SPRAYING\", \"to\": \"RTB\",      \"label\": \"mission_done!\", \"guard\": \"x >= 10\", \"reset\": \"x\" },\n    { \"from\": \"RTB\",      \"to\": \"LANDED\",   \"label\": \"landed!\",       \"guard\": \"x >= 5\" }\n  ]\n}\n",
    "interpretation": "; PT interpretation (flight-controller vocabulary) over drone.ont\n; --- propositions ---\nlanded        : (= alt 0)\nairborne      : (> alt 0)\nspraying      : (> flow 0)\nreturning     : rtb_active\n; --- events (nozzle_check is internal: no entry) ---\narm?          : armed\nstart_spray!  : (and (> alt 0) (> flow 0))\ncell_done!    : cell_complete\nbat_low!      : (< soc soc_rtb)\nmission_done! : (>= covered num_cells)\nlanded!       : (= alt 0)\n",
    "critical": "bat_low!"
  },
