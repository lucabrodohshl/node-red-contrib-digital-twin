  {
    "id": "behavior",
    "type": "dt-behavior",
    "z": "drone_tab",
    "name": "drone behaviour",
    "behavior": "{\n  \"name\": \"DroneDT\",\n  \"clocks\": [\n    \"t\"\n  ],\n  \"initial\": \"Ready\",\n  \"locations\": [\n    {\n      \"name\": \"Ready\",\n      \"labels\": [\n        \"onGround\"\n      ]\n    },\n    {\n      \"name\": \"Ascending\",\n      \"invariant\": \"t <= 8\",\n      \"labels\": [\n        \"flying\"\n      ]\n    },\n    {\n      \"name\": \"Spraying\",\n      \"invariant\": \"t <= 30\",\n      \"labels\": [\n        \"flying\",\n        \"dispensing\"\n      ]\n    },\n    {\n      \"name\": \"Returning\",\n      \"invariant\": \"t <= 20\",\n      \"labels\": [\n        \"flying\",\n        \"homing\"\n      ]\n    }\n  ],\n  \"edges\": [\n    {\n      \"from\": \"Ready\",\n      \"to\": \"Ascending\",\n      \"label\": \"takeOff\",\n      \"reset\": \"t\"\n    },\n    {\n      \"from\": \"Ready\",\n      \"to\": \"Ready\",\n      \"label\": \"optimizeRoute\"\n    },\n    {\n      \"from\": \"Ascending\",\n      \"to\": \"Spraying\",\n      \"label\": \"sprayStarted\",\n      \"guard\": \"t >= 3\",\n      \"reset\": \"t\"\n    },\n    {\n      \"from\": \"Spraying\",\n      \"to\": \"Spraying\",\n      \"label\": \"cellCompleted\",\n      \"guard\": \"t >= 10\",\n      \"reset\": \"t\"\n    },\n    {\n      \"from\": \"Spraying\",\n      \"to\": \"Spraying\",\n      \"label\": \"logTelemetry\"\n    },\n    {\n      \"from\": \"Spraying\",\n      \"to\": \"Returning\",\n      \"label\": \"lowBattery\",\n      \"reset\": \"t\"\n    },\n    {\n      \"from\": \"Spraying\",\n      \"to\": \"Returning\",\n      \"label\": \"missionComplete\",\n      \"guard\": \"t >= 10\",\n      \"reset\": \"t\"\n    },\n    {\n      \"from\": \"Returning\",\n      \"to\": \"Ready\",\n      \"label\": \"touchdown\",\n      \"guard\": \"t >= 5\"\n    }\n  ]\n}",
    "propositions": "onGround   : (<= altitude 0)\nflying     : (> altitude 0)\ndispensing : (> pumpFlow 0)\nhoming     : rtb_active",
    "x": 560,
    "y": 330,
    "wires": [
      []
    ]
  },
